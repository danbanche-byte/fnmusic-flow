FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg socat curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml .
RUN pip3 install --break-system-packages --no-cache-dir fastapi uvicorn pydantic httpx python-multipart mutagen fnos==0.13.0 opencc-python-reimplemented==0.1.7
COPY app ./app
RUN cd /app/app/integrated/pockettune-server \
    && npm ci --omit=dev
COPY app/integrated/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
EXPOSE 8000
CMD ["/app/entrypoint.sh"]
