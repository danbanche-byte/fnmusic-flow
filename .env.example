# 复制为 .env 后按需修改（compose 会自动读取同目录 .env）
# 你的飞牛音乐库宿主路径（必填）
MUSIC_HOST_PATH=/vol1/音乐
# 并发下载数（1-6，默认 3）
DOWNLOAD_CONCURRENCY=3
# 音质档位（默认 hires）
FNMUSIC_DEFAULT_QUALITY=hires
# 飞牛账号白名单（逗号分隔；留空 = 自动绑定本机可写账号）
# FNOS_ALLOWED_ACCOUNTS=你的账号
# 跨平台同曲兜底（默认关）
# ALTERNATE_SEARCH=true
# 内置解灰（默认关）
# UNM_ENABLED=true
